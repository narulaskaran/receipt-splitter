# Copy to .env.local for development; set the same variables in your Vercel
# project settings for deployment.

# --- Receipt parsing -------------------------------------------------------

# REQUIRED with the default provider (anthropic).
ANTHROPIC_API_KEY=

# Optional. Provider: anthropic (default) | openai | openrouter.
# Receipt images are sent to the selected provider.
# RECEIPT_LLM_PROVIDER=anthropic

# Optional. Override the provider's default model. Not namespaced per
# provider: update or unset it when you change RECEIPT_LLM_PROVIDER.
# RECEIPT_LLM_MODEL=

# REQUIRED only if RECEIPT_LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# REQUIRED only if RECEIPT_LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=

# --- Pasted receipt links --------------------------------------------------

# Optional. Firecrawl screenshots the pasted link; works without a key at
# lower rate limits.
# FIRECRAWL_API_KEY=

# Optional. Override the Firecrawl base URL (self-hosted).
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# --- Observability (all optional) ------------------------------------------

# UploadThing API token: stores receipt files for 90 days.
# UPLOADTHING_TOKEN=

# Slack or generic JSON webhook notified on each parse.
# WEBHOOK_URL=

# Protects /api/cron/cleanup-old-receipts from manual invocation.
# CRON_SECRET=
